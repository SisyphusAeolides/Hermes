module body Hermes.Bootstrap is
    record Sec2Loader: Linear is
        marker: Unit;
    end;

    record GspBootloader: Linear is
        marker: Unit;
    end;

    record BooterLoad: Linear is
        marker: Unit;
    end;

    record BooterUnload: Linear is
        marker: Unit;
    end;

    record VerifiedBundle: Linear is
        marker: Unit;
    end;

    record GspRmImage: Linear is
        marker: Unit;
    end;

    function measureSec2(): Sec2Loader is
        return Sec2Loader(marker => nil);
    end;

    function measureGspBoot(): GspBootloader is
        return GspBootloader(marker => nil);
    end;

    function measureBooterLoad(): BooterLoad is
        return BooterLoad(marker => nil);
    end;

    function measureBooterUnload(): BooterUnload is
        return BooterUnload(marker => nil);
    end;

    function measureGspRm(): GspRmImage is
        return GspRmImage(marker => nil);
    end;

    function verifyBundle(
        sec2: Sec2Loader,
        gspBoot: GspBootloader,
        load: BooterLoad,
        unload: BooterUnload
    ): VerifiedBundle is
        let { marker: Unit } := sec2;
        let s: Unit := marker;
        let { marker: Unit } := gspBoot;
        let g: Unit := marker;
        let { marker: Unit } := load;
        let l: Unit := marker;
        let { marker: Unit } := unload;
        let u: Unit := marker;
        let d1: Unit := g;
        let d2: Unit := l;
        let d3: Unit := u;
        return VerifiedBundle(marker => s);
    end;

    function attachRm(bundle: VerifiedBundle, rm: GspRmImage): VerifiedBundle is
        let { marker: Unit } := bundle;
        let b: Unit := marker;
        let { marker: Unit } := rm;
        let r: Unit := marker;
        let discarded: Unit := r;
        return VerifiedBundle(marker => b);
    end;

    function releaseBundle(bundle: VerifiedBundle): Unit is
        let { marker: Unit } := bundle;
        return marker;
    end;
end module body.
