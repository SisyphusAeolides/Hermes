module Hermes.Mailbox is
    -- Linear Falcon mailbox session: HELLO post consumes the session token.

    type GspOnline: Free;
    type MailboxSession: Linear;
    type Response: Free;

    function requireGsp(): GspOnline;
    function openMailbox(g: GspOnline): MailboxSession;
    function postHello(m: MailboxSession): Response;
    function observeReady(r: Response): Bool;
end module.
