module Hermes.HostGate is
    -- Linear Online authority token only mintable after host gates pass.

    type HostFacts: Free;
    type OnlineAuthority: Linear;

    function observeFacts(): HostFacts;
    function isolationReady(f: HostFacts): Bool;
    function mayClaimOnline(f: HostFacts): Bool;
    function mintAuthority(f: HostFacts): OnlineAuthority;
    function dropAuthority(a: OnlineAuthority): Unit;
end module.
