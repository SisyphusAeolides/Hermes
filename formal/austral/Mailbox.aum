module body Hermes.Mailbox is
    record GspOnline: Free is
        marker: Unit;
    end;

    record MailboxSession: Linear is
        marker: Unit;
    end;

    record Response: Free is
        ready: Bool;
    end;

    function requireGsp(): GspOnline is
        return GspOnline(marker => nil);
    end;

    function openMailbox(g: GspOnline): MailboxSession is
        let { marker: Unit } := g;
        return MailboxSession(marker => marker);
    end;

    function postHello(m: MailboxSession): Response is
        let { marker: Unit } := m;
        let _consumed: Unit := marker;
        return Response(ready => true);
    end;

    function observeReady(r: Response): Bool is
        let { ready: Bool } := r;
        return ready;
    end;
end module body.
