module Hermes.Bootstrap is
    -- Linear five-file Turing bootstrap bundle (SEC2, GSP BL, Booter Load/Unload).
    -- Each role is a linear token; pairing consumes roles into a verified bundle.

    type Sec2Loader: Linear;
    type GspBootloader: Linear;
    type BooterLoad: Linear;
    type BooterUnload: Linear;
    type VerifiedBundle: Linear;
    type GspRmImage: Linear;

    function measureSec2(): Sec2Loader;
    function measureGspBoot(): GspBootloader;
    function measureBooterLoad(): BooterLoad;
    function measureBooterUnload(): BooterUnload;
    function measureGspRm(): GspRmImage;

    function verifyBundle(
        sec2: Sec2Loader,
        gspBoot: GspBootloader,
        load: BooterLoad,
        unload: BooterUnload
    ): VerifiedBundle;

    function attachRm(bundle: VerifiedBundle, rm: GspRmImage): VerifiedBundle;
    function releaseBundle(bundle: VerifiedBundle): Unit;
end module.
