module body Hermes.Firmware is
    record RawImage: Free is
        marker: Unit;
    end;

    record Family: Free is
        marker: Unit;
    end;

    record Digest: Free is
        marker: Unit;
    end;

    record ElfStructure: Free is
        marker: Unit;
    end;

    record FirmwareSeal: Linear is
        marker: Unit;
    end;

    record Rejected: Free is
        marker: Unit;
    end;

    function openImage(): RawImage is
        return RawImage(marker => nil);
    end;

    function classifyFamily(image: RawImage): Family is
        let { marker: Unit } := image;
        return Family(marker => marker);
    end;

    function hashImage(image: RawImage): Digest is
        let { marker: Unit } := image;
        return Digest(marker => marker);
    end;

    function parseElf(image: RawImage): ElfStructure is
        let { marker: Unit } := image;
        return ElfStructure(marker => marker);
    end;

    function seal(
        family: Family,
        digest: Digest,
        elf: ElfStructure
    ): FirmwareSeal is
        let { marker: Unit } := family;
        let f: Unit := marker;
        let { marker: Unit } := digest;
        let d: Unit := marker;
        let { marker: Unit } := elf;
        let e: Unit := marker;
        let discardedDigest: Unit := d;
        let discardedElf: Unit := e;
        return FirmwareSeal(marker => f);
    end;

    function reject(image: RawImage): Rejected is
        let { marker: Unit } := image;
        return Rejected(marker => marker);
    end;

    function discardSeal(seal: FirmwareSeal): Unit is
        let { marker: Unit } := seal;
        return marker;
    end;
end module body.
