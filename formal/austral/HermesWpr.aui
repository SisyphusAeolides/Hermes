module Hermes.Wpr is
    -- Linear ownership of Turing WPR2 metadata and framebuffer geometry.
    -- Mirrors OpenRM GspFwWprMeta handoff: CPU builds the record; Booter locks it.

    type FramebufferEvidence: Free;
    type DmaBindings: Free;
    type BootOffsets: Free;
    type WprPlan: Linear;
    type Sec2Mailbox: Linear;
    type Wpr2Active: Free;

    function observeFramebuffer(): FramebufferEvidence;
    function observeDma(): DmaBindings;
    function observeBootOffsets(): BootOffsets;

    function buildPlan(
        fb: FramebufferEvidence,
        dma: DmaBindings,
        boot: BootOffsets
    ): WprPlan;

    function discardPlan(plan: WprPlan): Unit;

    function submitBooterLoad(plan: WprPlan): Sec2Mailbox;
    function completeBooter(
        mailbox: Sec2Mailbox,
        wpr2: Wpr2Active
    ): Unit;

    function rejectBooter(mailbox: Sec2Mailbox): Unit;
    function observeWpr2Active(): Wpr2Active;
end module.
