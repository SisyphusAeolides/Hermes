module body Hermes.DrmKms is
    record GspOnline: Free is
        marker: Unit;
    end;

    record Crtc: Linear is
        marker: Unit;
    end;

    record Plane: Linear is
        marker: Unit;
    end;

    record Framebuffer: Free is
        marker: Unit;
    end;

    record Modeset: Linear is
        marker: Unit;
    end;

    function requireGsp(): GspOnline is
        return GspOnline(marker => nil);
    end;

    function openCrtc(g: GspOnline): Crtc is
        let { marker: Unit } := g;
        return Crtc(marker => marker);
    end;

    function openPlane(g: GspOnline): Plane is
        let { marker: Unit } := g;
        return Plane(marker => marker);
    end;

    function bindFramebuffer(p: Plane, fb: Framebuffer): Plane is
        let { marker: Unit } := p;
        let a: Unit := marker;
        let { marker: Unit } := fb;
        let b: Unit := marker;
        let _b: Unit := b;
        return Plane(marker => a);
    end;

    function atomicApply(c: Crtc, p: Plane, g: GspOnline): Modeset is
        let { marker: Unit } := c;
        let a: Unit := marker;
        let { marker: Unit } := p;
        let b: Unit := marker;
        let { marker: Unit } := g;
        let gUnit: Unit := marker;
        let _b: Unit := b;
        let _g: Unit := gUnit;
        return Modeset(marker => a);
    end;

    function disableCrtc(m: Modeset): GspOnline is
        let { marker: Unit } := m;
        return GspOnline(marker => marker);
    end;

    function closeModeset(m: Modeset): Unit is
        let { marker: Unit } := m;
        return marker;
    end;
end module body.
