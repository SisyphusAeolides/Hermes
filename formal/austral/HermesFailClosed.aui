module Hermes.FailClosed is
    -- A live GPU handle is linear. Failure consumes it into Quarantine; there
    -- is no Free constructor for an online device that skipped a gate.
    type Probe: Free;
    type LiveGpu: Linear;
    type Quarantine: Free;
    type Offline: Free;

    function probe(): Probe;
    function activate(probe: Probe): LiveGpu;
    function fault(gpu: LiveGpu): Quarantine;
    function recover(q: Quarantine): LiveGpu;
    function contain(q: Quarantine): Offline;
    function release(gpu: LiveGpu): Offline;
end module.
