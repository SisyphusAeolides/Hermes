module body Hermes.Rings is
    record CommandRing: Linear is
        depth: Nat32;
    end;

    record EventRing: Linear is
        depth: Nat32;
    end;

    record ArmedTransport: Linear is
        commandDepth: Nat32;
        eventDepth: Nat32;
    end;

    record SlotToken: Linear is
        commandDepth: Nat32;
        eventDepth: Nat32;
    end;

    function armCommand(depth: Nat32): CommandRing is
        return CommandRing(depth => depth);
    end;

    function armEvent(depth: Nat32): EventRing is
        return EventRing(depth => depth);
    end;

    function takeCommandDepth(command: CommandRing): Nat32 is
        let { depth: Nat32 } := command;
        return depth;
    end;

    function takeEventDepth(event: EventRing): Nat32 is
        let { depth: Nat32 } := event;
        return depth;
    end;

    function pairRings(command: CommandRing, event: EventRing): ArmedTransport is
        let commandDepth: Nat32 := takeCommandDepth(command);
        let eventDepth: Nat32 := takeEventDepth(event);
        return ArmedTransport(
            commandDepth => commandDepth,
            eventDepth => eventDepth
        );
    end;

    function disarm(transport: ArmedTransport): Unit is
        let { commandDepth: Nat32, eventDepth: Nat32 } := transport;
        let discardedCommand: Nat32 := commandDepth;
        let discardedEvent: Nat32 := eventDepth;
        return nil;
    end;

    function takeSlot(transport: ArmedTransport): SlotToken is
        let { commandDepth: Nat32, eventDepth: Nat32 } := transport;
        return SlotToken(
            commandDepth => commandDepth,
            eventDepth => eventDepth
        );
    end;

    function retireSlot(token: SlotToken): ArmedTransport is
        let { commandDepth: Nat32, eventDepth: Nat32 } := token;
        return ArmedTransport(
            commandDepth => commandDepth,
            eventDepth => eventDepth
        );
    end;
end module body.
