module body Hermes.Resources is
    record PciMatch: Free is
        marker: Unit;
    end;

    record FirmwareSeal: Linear is
        marker: Unit;
    end;

    record IommuDomain: Linear is
        marker: Unit;
    end;

    record MmioWindow: Linear is
        domainMarker: Unit;
    end;

    record DmaRegion: Linear is
        domainMarker: Unit;
    end;

    record WprLock: Linear is
        domainMarker: Unit;
    end;

    record MailboxOk: Free is
        marker: Unit;
    end;

    record ReadyQueue: Free is
        marker: Unit;
    end;

    record FeatureSet: Free is
        marker: Unit;
    end;

    record OnlineSession: Linear is
        marker: Unit;
    end;

    function matchPci(): PciMatch is
        return PciMatch(marker => nil);
    end;

    function rejectPci(match: PciMatch): Unit is
        let { marker: Unit } := match;
        return marker;
    end;

    function measureFirmware(match: PciMatch): FirmwareSeal is
        let { marker: Unit } := match;
        return FirmwareSeal(marker => marker);
    end;

    function discardFirmware(seal: FirmwareSeal): Unit is
        let { marker: Unit } := seal;
        return marker;
    end;

    function isolate(seal: FirmwareSeal): IommuDomain is
        let { marker: Unit } := seal;
        return IommuDomain(marker => marker);
    end;

    function releaseDomain(domain: IommuDomain): Unit is
        let { marker: Unit } := domain;
        return marker;
    end;

    function mapBar(domain: IommuDomain): MmioWindow is
        let { marker: Unit } := domain;
        return MmioWindow(domainMarker => marker);
    end;

    function unmapBar(window: MmioWindow): IommuDomain is
        let { domainMarker: Unit } := window;
        return IommuDomain(marker => domainMarker);
    end;

    function allocateDma(domain: IommuDomain): DmaRegion is
        let { marker: Unit } := domain;
        return DmaRegion(domainMarker => marker);
    end;

    function releaseDma(region: DmaRegion): IommuDomain is
        let { domainMarker: Unit } := region;
        return IommuDomain(marker => domainMarker);
    end;

    function lockWpr(domain: IommuDomain): WprLock is
        let { marker: Unit } := domain;
        return WprLock(domainMarker => marker);
    end;

    function unlockWpr(lock: WprLock): IommuDomain is
        let { domainMarker: Unit } := lock;
        return IommuDomain(marker => domainMarker);
    end;

    function observeMailbox(): MailboxOk is
        return MailboxOk(marker => nil);
    end;

    function observeReady(): ReadyQueue is
        return ReadyQueue(marker => nil);
    end;

    function admitFeatures(): FeatureSet is
        return FeatureSet(marker => nil);
    end;

    -- Online requires simultaneous consumption of the IOMMU domain and WPR
    -- lock plus free evidence tokens. There is no OnlineSession constructor
    -- that skips a linear argument; leaking either resource is a type error.
    function ignite(
        domain: IommuDomain,
        wpr: WprLock,
        mailbox: MailboxOk,
        ready: ReadyQueue,
        features: FeatureSet
    ): OnlineSession is
        let withMailbox: IommuDomain := foldMailbox(domain, mailbox);
        let withReady: IommuDomain := foldReady(withMailbox, ready);
        let withFeatures: IommuDomain := foldFeatures(withReady, features);
        return foldWpr(withFeatures, wpr);
    end;

    function foldMailbox(domain: IommuDomain, mailbox: MailboxOk): IommuDomain is
        let { marker: Unit } := domain;
        let domainUnit: Unit := marker;
        discardMailbox(mailbox);
        return IommuDomain(marker => domainUnit);
    end;

    function discardMailbox(mailbox: MailboxOk): Unit is
        let { marker: Unit } := mailbox;
        return marker;
    end;

    function foldReady(domain: IommuDomain, ready: ReadyQueue): IommuDomain is
        let { marker: Unit } := domain;
        let domainUnit: Unit := marker;
        discardReady(ready);
        return IommuDomain(marker => domainUnit);
    end;

    function discardReady(ready: ReadyQueue): Unit is
        let { marker: Unit } := ready;
        return marker;
    end;

    function foldFeatures(domain: IommuDomain, features: FeatureSet): IommuDomain is
        let { marker: Unit } := domain;
        let domainUnit: Unit := marker;
        discardFeatures(features);
        return IommuDomain(marker => domainUnit);
    end;

    function discardFeatures(features: FeatureSet): Unit is
        let { marker: Unit } := features;
        return marker;
    end;

    function foldWpr(domain: IommuDomain, wpr: WprLock): OnlineSession is
        let { marker: Unit } := domain;
        let domainUnit: Unit := marker;
        discardWpr(wpr);
        return OnlineSession(marker => domainUnit);
    end;

    function discardWpr(wpr: WprLock): Unit is
        let { domainMarker: Unit } := wpr;
        return domainMarker;
    end;

    function shutdown(session: OnlineSession): Unit is
        let { marker: Unit } := session;
        return marker;
    end;
end module body.
