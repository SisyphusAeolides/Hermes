module Hermes.Resources is
    -- Free evidence may be copied; linear resources must be consumed exactly once.
    type PciMatch: Free;
    type FirmwareSeal: Linear;
    type IommuDomain: Linear;
    type MmioWindow: Linear;
    type DmaRegion: Linear;
    type WprLock: Linear;
    type MailboxOk: Free;
    type ReadyQueue: Free;
    type FeatureSet: Free;
    type OnlineSession: Linear;

    function matchPci(): PciMatch;
    function rejectPci(match: PciMatch): Unit;

    function measureFirmware(match: PciMatch): FirmwareSeal;
    function discardFirmware(seal: FirmwareSeal): Unit;

    function isolate(seal: FirmwareSeal): IommuDomain;
    function releaseDomain(domain: IommuDomain): Unit;

    function mapBar(domain: IommuDomain): MmioWindow;
    function unmapBar(window: MmioWindow): IommuDomain;

    function allocateDma(domain: IommuDomain): DmaRegion;
    function releaseDma(region: DmaRegion): IommuDomain;

    function lockWpr(domain: IommuDomain): WprLock;
    function unlockWpr(lock: WprLock): IommuDomain;

    function observeMailbox(): MailboxOk;
    function observeReady(): ReadyQueue;
    function admitFeatures(): FeatureSet;

    function ignite(
        domain: IommuDomain,
        wpr: WprLock,
        mailbox: MailboxOk,
        ready: ReadyQueue,
        features: FeatureSet
    ): OnlineSession;

    function shutdown(session: OnlineSession): Unit;
end module.
