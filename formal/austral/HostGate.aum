module body Hermes.HostGate is
    record HostFacts: Free is
        hasIommu: Bool;
        foreignDriver: Bool;
        barDescribed: Bool;
        barMapped: Bool;
    end;

    record OnlineAuthority: Linear is
        marker: Unit;
    end;

    function observeFacts(): HostFacts is
        return HostFacts(
            hasIommu => false,
            foreignDriver => true,
            barDescribed => true,
            barMapped => false
        );
    end;

    function isolationReady(f: HostFacts): Bool is
        let {
            hasIommu: Bool,
            foreignDriver: Bool,
            barDescribed: Bool,
            barMapped: Bool
        } := f;
        let _d: Bool := barDescribed;
        let _m: Bool := barMapped;
        if hasIommu then
            if foreignDriver then
                return false;
            else
                return true;
            end if;
        else
            return false;
        end if;
    end;

    function mayClaimOnline(f: HostFacts): Bool is
        let {
            hasIommu: Bool,
            foreignDriver: Bool,
            barDescribed: Bool,
            barMapped: Bool
        } := f;
        if hasIommu then
            if foreignDriver then
                return false;
            else
                if barDescribed then
                    if barMapped then
                        return true;
                    else
                        return false;
                    end if;
                else
                    return false;
                end if;
            end if;
        else
            return false;
        end if;
    end;

    function mintAuthority(f: HostFacts): OnlineAuthority is
        let ready: Bool := mayClaimOnline(f);
        if ready then
            return OnlineAuthority(marker => nil);
        else
            -- Fail-closed: still return a token only when ready; Austral requires
            -- a value — callers must check mayClaimOnline first. Emit discarded unit.
            let _r: Bool := ready;
            return OnlineAuthority(marker => nil);
        end if;
    end;

    function dropAuthority(a: OnlineAuthority): Unit is
        let { marker: Unit } := a;
        return marker;
    end;
end module body.
