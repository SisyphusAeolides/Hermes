module body Hermes.DropIn is
    record Session: Free is
        online: Bool;
        devices: Nat32;
    end;

    record SmiView: Free is
        devices: Nat32;
    end;

    function openOfflineSession(devices: Nat32): Session is
        return Session(online => false, devices => devices);
    end;

    function promoteOnline(s: Session): Session is
        let { online: Bool, devices: Nat32 } := s;
        let _o: Bool := online;
        return Session(online => true, devices => devices);
    end;

    function smiList(s: Session): SmiView is
        let { online: Bool, devices: Nat32 } := s;
        let _o: Bool := online;
        return SmiView(devices => devices);
    end;

    function catalogSize(): Nat32 is
        return 17;
    end;

    function closeSession(s: Session): Unit is
        let { online: Bool, devices: Nat32 } := s;
        let _o: Bool := online;
        let _d: Nat32 := devices;
        return nil;
    end;
end module body.
